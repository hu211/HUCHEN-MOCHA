<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= locals.title || 'Mocha - Matcha Bar' %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-mocha-main d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
        <div class="container">
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <a class="navbar-brand fw-bold text-mocha-wood" href="/" data-link>MOCHA</a>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="/" data-link>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/menu" data-link>Menu</a>
                    </li>

                    <div id="nav-user-container" class="d-flex align-items-center"></div>
                </ul>

                <div class="d-flex align-items-center">
                    <a href="/cart" class="nav-link text-white me-4" data-link>
                        <i class="bi bi-cart3 fs-5"></i>
                    </a>

                    <form class="d-flex" id="search-form">
                        <div class="input-group">
                            <input class="form-control form-control-sm border-0 search-input-custom" type="search" id="search-input"
                                placeholder="Search..." aria-label="Search">
                            <button class="btn btn-sm btn-outline-light border-0 search-btn-custom" type="submit">
                                <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#FFFFFF">
                                    <path
                                        d="M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z" />
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <main id="app-content" class="flex-grow-1">
        <div class="d-flex justify-content-center align-items-center h-100 mt-5">
            <div class="spinner-border text-matcha-subtle" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </main>

    <footer class="bg-dark text-white mt-auto py-4">
        <div class="container text-center">
            <p class="mb-1">© 2026 Mocha - Speciality Matcha Bar</p>
            <small class="text-secondary">Barcelona, España</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://unpkg.com/page/page.js"></script>

    <script>
        document.addEventListener('error', function (e) {
            if (e.target.tagName && e.target.tagName.toLowerCase() === 'img') {
                if (!e.target.dataset.fallbackApplied) {
                    e.target.dataset.fallbackApplied = true;
                    e.target.src = 'https://placehold.co/400x300?text=Image+Not+Found';
                }
            }
        }, true);
    </script>

    <script src="/js/app.js" type="module"></script>
</body>

</html>